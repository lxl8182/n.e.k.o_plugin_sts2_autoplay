<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SimTests</RootNamespace>
    <AssemblyName>SimTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- Link the pure Sim sources (they are game-type-free) from the mod project itself. Game-coupled
       files (SimBuild / SimCapture / SimSolverPlan) are excluded so this runs without sts2.dll.
       T40: the old path was "..\neko_comm\Game\Sim\" — that directory does not exist (the sim sources
       live in "..\nekospire\Game\Sim\"), so the whole gate failed with 15x CS2001 and the mod had no
       runnable automated verification at all. -->
  <ItemGroup>
    <Reference Include="System.IO.Hashing">
      <HintPath>D:/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\nekospire\Game\Sim\SimGameRandom.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimPayload.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimState.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimCommand.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimResolver.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimDiff.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimReplay.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimRng.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimPower.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimIntents.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimBudget.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimSearch.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimOrb.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimRelic.cs" />
    <Compile Include="..\nekospire\Game\Sim\SimOnPlay.cs" />
    <!-- T40: the shared card-side coverage classifier (pure; the mod compiles the same file through
         its default **/*.cs glob, so the gate tests the shipping logic, not a copy). -->
    <Compile Include="..\nekospire\Game\Sim\SimCoverage.cs" />
  </ItemGroup>
</Project>
